# Salin menjadi .env lalu isi nilainya.
# Jangan commit file .env.

# Dipakai webhook Vercel dan bot.py lokal
BOT_TOKEN=
PUSH_SECRET=

# Webhook Vercel
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Secret webhook Telegram. Isi teks acak (A-Z a-z 0-9 _ -, 1-256 karakter),
# redeploy, lalu daftarkan ke Telegram:
#   curl "https://api.telegram.org/bot<BOT_TOKEN>/setWebhook" \
#     -d "url=https://<domain-vercel>/api/telegram" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# Kalau kosong, webhook menerima semua request (tidak aman).
TELEGRAM_WEBHOOK_SECRET=

# Rahasia pemanggilan cron Vercel. Isi teks acak, lalu redeploy.
CRON_SECRET=

# Hanya bot.py lokal (polling + villa.db)
PUSH_PORT=8080
